# Tema GTK MacTahoe (vinceliuice), pinado, sem logos de terceiros.
# Usa os temas já compilados da pasta release/ do projeto: o
# instalador do projeto depende de sudo/logname/getent e falha num build automatizado.
pkgname=brisa-mactahoe-gtk
pkgver=0.r1
pkgrel=1
pkgdesc="Tema GTK MacTahoe empacotado para a distro"
arch=('any')
url="https://github.com/vinceliuice/MacTahoe-gtk-theme"
license=('MIT')
makedepends=('git')
source=("MacTahoe-gtk-theme::git+https://github.com/vinceliuice/MacTahoe-gtk-theme.git#commit=1e45e19f510edb8cde18fa84d6cd5319f60b086b")
sha256sums=('SKIP')

brisa_strip_trademarks() { "$startdir/../brisa-strip-trademarks.sh" "$1"; }

package() {
  install -d "$pkgdir/usr/share/themes"
  tar -xJf MacTahoe-gtk-theme/release/MacTahoe-Light.tar.xz -C "$pkgdir/usr/share/themes"
  tar -xJf MacTahoe-gtk-theme/release/MacTahoe-Dark.tar.xz -C "$pkgdir/usr/share/themes"
  brisa_strip_trademarks "$pkgdir/usr/share/themes"
}
