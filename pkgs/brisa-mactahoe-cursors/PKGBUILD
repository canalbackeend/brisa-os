# Cursores MacTahoe (pasta cursors/ do repositório de ícones), pinados.
pkgname=brisa-mactahoe-cursors
pkgver=0.r1
pkgrel=1
pkgdesc="Cursores MacTahoe empacotados para a distro"
arch=('any')
url="https://github.com/vinceliuice/MacTahoe-icon-theme"
license=('GPL-3.0-or-later')
makedepends=('git')
source=("MacTahoe-icon-theme::git+https://github.com/vinceliuice/MacTahoe-icon-theme.git#commit=839848b9a8a38a92a6936e30c4abe35cc6f2546d")
sha256sums=('SKIP')

package() {
  cd MacTahoe-icon-theme/cursors
  install -d "$pkgdir/usr/share/icons"
  cp -r dist "$pkgdir/usr/share/icons/MacTahoe-cursors"
  cp -r dist-dark "$pkgdir/usr/share/icons/MacTahoe-dark-cursors"
}
